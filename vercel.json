{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist-site",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/login", "destination": "/api/login.ts" },
    { "source": "/api/check", "destination": "/api/check.ts" },
    { "source": "/api/ssl", "destination": "/api/ssl.ts" },
    { "source": "/api/whois", "destination": "/api/whois.ts" },
    { "source": "/api/dns", "destination": "/api/dns.ts" },
    { "source": "/api/gmb", "destination": "/api/gmb.ts" },
    { "source": "/api/tech-detect", "destination": "/api/tech-detect.ts" },
    { "source": "/api/canonical", "destination": "/api/canonical.ts" },
    { "source": "/content/:path*", "destination": "/content/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
